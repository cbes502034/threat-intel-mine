# 複製此檔為 .env 並填入實際值（.env 已被 .gitignore 忽略，請勿提交到 Git）
# cp .env.example .env

# --- Claude（預設的答案生成模型）---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- 資料庫（對應 compose.yml 的 db 服務）---
DB_HOST=db
DB_PORT=5432
DB_NAME=thread_intel_mine
DB_USER=postgres
# 需與 compose.yml 中的 POSTGRES_PASSWORD 相同
DB_PASSWORD=your_db_password_here

# --- 選填：改用本機 Ollama 模型生成答案（預設為 claude）---
# LLM_PROVIDER=ollama
